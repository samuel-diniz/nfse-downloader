# =============================================================================
# Copie este arquivo para .env e preencha com os dados do contribuinte.
# O arquivo .env esta no .gitignore e NAO sera commitado.
# =============================================================================

# --- Obrigatorios ---

# Thumbprint (SHA-1) do certificado digital A1 instalado no repositorio
# do Windows (CurrentUser\My). Obtem-se no certmgr.msc, aba "Detalhes",
# campo "Thumbprint" -- copie sem espacos, tudo em maiusculas.
CERT_THUMBPRINT=

# CNPJ do contribuinte, somente digitos (14 caracteres, sem pontuacao).
CNPJ_CONTRIBUINTE=

# Pasta base para salvar os XMLs. Pode usar {ano} como marcador, que sera
# substituido pelo valor de ANO_DESTINO. As subpastas de mes ("01", "02"...)
# sao criadas automaticamente dentro dela.
# Exemplo:
#   PASTA_BASE_DESTINO=Z:\FISCAL\{ano}\NFSE\CLIENTE_X\Prestacao
PASTA_BASE_DESTINO=

# --- Opcionais (tem default no codigo) ---

# Periodo de busca por data de emissao (tag <dhEmi> do XML), AAAA-MM-DD.
DATA_INICIO=2026-01-01
DATA_FIM=2026-12-31

# Ano usado para substituir {ano} em PASTA_BASE_DESTINO.
ANO_DESTINO=2026

# NSU inicial (0 = do comeco do historico disponivel).
NSU_INICIAL=0

# true = homologacao (producao restrita), false = producao oficial.
USAR_PRODUCAO_RESTRITA=false

# Caminho do curl.exe do Windows. So mude se estiver em local diferente.
CURL_EXE=C:\Windows\System32\curl.exe
